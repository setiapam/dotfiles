# Solarized Osaka Dark — btop theme
# Based on craftzdog/solarized-osaka.nvim
# Background anchored at #000c10, accent cyan #29a298

# Main background
theme[main_bg]="#000c10"

# Main text color
theme[main_fg]="#9eabac"

# Title color for boxes
theme[title]="#adb7b7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#29a298"

# Background color of selected items
theme[selected_bg]="#103a3c"

# Foreground color of selected items
theme[selected_fg]="#fdf5e2"

# Color of inactive/disabled text
theme[inactive_fg]="#576d74"

# Color of text appearing on top of graphs
theme[graph_text]="#adb7b7"

# Misc colors for processes box
theme[proc_misc]="#adb7b7"

# Cpu box outline color
theme[cpu_box]="#29a298"

# Memory/disks box outline color
theme[mem_box]="#268bd3"

# Net up/down box outline color
theme[net_box]="#849900"

# Processes box outline color
theme[proc_box]="#576d74"

# Box divider line and small boxes line color
theme[div_line]="#002c38"

# Temperature graph colors
theme[temp_start]="#849900"
theme[temp_mid]="#b28500"
theme[temp_end]="#db302d"

# CPU graph colors — cyan ramp (dim → bright)
theme[cpu_start]="#103a3c"
theme[cpu_mid]="#29a298"
theme[cpu_end]="#2aeddd"

# Mem/Disk free meter — blue ramp
theme[free_start]="#0f3856"
theme[free_mid]="#268bd3"
theme[free_end]="#5eaaf5"

# Mem/Disk cached meter — green ramp
theme[cached_start]="#2c3300"
theme[cached_mid]="#849900"
theme[cached_end]="#b8cc52"

# Mem/Disk available meter — cyan ramp
theme[available_start]="#103a3c"
theme[available_mid]="#29a298"
theme[available_end]="#2aeddd"

# Mem/Disk used meter — yellow → red ramp
theme[used_start]="#332700"
theme[used_mid]="#b28500"
theme[used_end]="#db302d"

# Download graph colors — blue ramp (dark → bright)
theme[download_start]="#0f3856"
theme[download_mid]="#268bd3"
theme[download_end]="#5eaaf5"

# Upload graph colors — green ramp (dark → bright)
theme[upload_start]="#2c3300"
theme[upload_mid]="#849900"
theme[upload_end]="#b8cc52"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#29a298"
theme[process_mid]="#b28500"
theme[process_end]="#db302d"
